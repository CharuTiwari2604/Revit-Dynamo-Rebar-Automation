        }
      ],
      "Replication": "Disabled",
      "Description": "Visualizes a node's output"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk.Revit.DB as DB\r\nimport Autodesk.Revit.DB.Structure as DBStruct\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\nhost=UnwrapElement(IN[0])\r\n\r\nif not host:\r\n    OUT='Please Select host'\r\nelse:\r\n    rebar_type=DB.FilteredElementCollector(doc) \\\r\n    .OfClass(DBStruct.RebarBarType) \\\r\n    .WhereElementIsElementType() \\\r\n    .FirstElement()\r\n\r\n    bbox=host.get_BoundingBox(None)\r\n    ptmin=bbox.Min\r\n    ptmax=bbox.Max\r\n\r\n    cover_ft = 40.0/304.8\r\n\r\n    start_x = ptmin.X + cover_ft\r\n    start_y = ptmin.Y + cover_ft\r\n    start_z=ptmin.Z + cover_ft\r\n\r\n    end_x=start_x\r\n    end_y=start_y\r\n    end_z=ptmax.Z - cover_ft\r\n\r\n    p1=DB.XYZ(start_x, start_y, start_z)\r\n    p2=DB.XYZ(end_x, end_y, end_z)\r\n\r\n    barline=DB.Line.CreateBound(p1,p2)\r\n    curves=List[DB.Curve]()\r\n    curves.Add(barline)\r\n    norm=DB.XYZ(1,0,0)\r\n\r\n    bar_terminates = DBStruct.BarTerminationsData(doc)\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    new_rebar=DBStruct.Rebar.CreateFromCurves(\r\n    doc,\r\n    DBStruct.RebarStyle.Standard,\r\n    rebar_type,\r\n    host,\r\n    norm,\r\n    curves,\r\n    bar_terminates,\r\n    True,\r\n    True\r\n    )\r\n    \r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    \r\n    OUT = \"SUCCESS: Created Rebar ID: {}\".format(new_rebar.Id.ToString())\r\n    \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "821fe2703e7941518a206a790a9e4b96",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "461ff9adfabe4b2cab26cc93782e403b",
          "Name": "IN[0]",
          "Description": "Input #0",
