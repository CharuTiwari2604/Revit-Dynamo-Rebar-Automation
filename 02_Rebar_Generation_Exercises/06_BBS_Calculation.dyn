  "Name": "6rebarexercise",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "f22753d7-9f09-489c-8d4a-5376f44beb12-001990b4"
      ],
      "Id": "9b95b0f5d1bb4fc9994a8af1cba3f652",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "f2752315c835472c9e973f22fa397916",
          "Name": "Element",
          "Description": "The selected elements.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select a model element from the document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk.Revit.DB as DB\r\nimport Autodesk.Revit.DB.Structure as DBStruct\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nhost = UnwrapElement(IN[0])\r\n\r\nif not host:\r\n    OUT = \"Error: Select a concrete column in IN[0]\"\r\nelse:\r\n    rebar_collector = DB.FilteredElementCollector(doc) \\\r\n        .OfClass(DBStruct.Rebar) \\\r\n        .ToElements()\r\n\r\n    host_rebars = [r for r in rebar_collector if r.GetHostId() == host.Id]\r\n\r\n    if not host_rebars:\r\n        OUT = \"Error: No rebar found hosted in the selected column.\"\r\n    else:\r\n        bbs_data = []\r\n        total_steel_weight_kg = 0.0\r\n        \r\n        for idx, rebar in enumerate(host_rebars, start=1):\r\n            r_type = doc.GetElement(rebar.GetTypeId())\r\n            type_name = r_type.Name if r_type else \"Unknown\"\r\n\r\n            dia_ft = r_type.BarNominalDiameter if r_type else 0.0\r\n            dia_mm = dia_ft * 304.8\r\n\r\n            length_ft = rebar.TotalLength\r\n            length_mm = length_ft * 304.8\r\n            length_m = length_mm / 1000.0\r\n\r\n            qty = rebar.Quantity\r\n\r\n            unit_weight_kg_per_m = (dia_mm ** 2) / 162.0\r\n            total_bar_weight_kg = length_m * qty * unit_weight_kg_per_m\r\n            total_steel_weight_kg += total_bar_weight_kg\r\n\r\n            record = \"Rebar #{}: Type={}, Qty={}, Dia={:.1f}mm, Length={:.2f}m, Total Weight={:.2f}kg\".format(\r\n                idx,\r\n                type_name,\r\n                qty,\r\n                dia_mm,\r\n                length_m,\r\n                total_bar_weight_kg\r\n            )\r\n            bbs_data.append(record)\r\n\r\n        bbs_data.append(\"TOTAL STEEL WEIGHT FOR COLUMN: {:.2f} kg\".format(total_steel_weight_kg))\r\n\r\n        OUT = bbs_data\r\n        \r\n        ",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "0859ce117a0e4362bc44ddc6d1255502",
      "NodeType": "PythonScriptNode",
      "Inputs": [
