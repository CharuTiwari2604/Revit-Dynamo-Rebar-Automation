  "Description": "",
  "Name": "3rebarexercise",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "f22753d7-9f09-489c-8d4a-5376f44beb12-001990b4"
      ],
      "Id": "fee57e082ed44924b5b32fee3bc391ff",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "7f420d9fd765430080a59fe3ba9bf5f4",
          "Name": "Element",
          "Description": "The selected elements.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select a model element from the document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nfrom System.Collections.Generic import  List\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk.Revit.DB as DB\r\nimport Autodesk.Revit.DB.Structure as DBStruct\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\nhost=UnwrapElement(IN[0])\r\n\r\nif not host:\r\n    OUT='Error: Please select a column'\r\nelse:\r\n    rebar_type=DB.FilteredElementCollector(doc) \\\r\n    .OfClass(DBStruct.RebarBarType) \\\r\n    .WhereElementIsElementType() \\\r\n    .FirstElement()\r\n    \r\n    if not rebar_type:\r\n        OUT='No Rebar Bar type found'\r\n    else:\r\n        bbox=host.get_BoundingBox(None)\r\n        ptmin=bbox.Min\r\n        ptmax=bbox.Max\r\n        \r\n        cover_ft=40.0/304.8\r\n        \r\n        xmin=ptmin.X+cover_ft\r\n        xmax=ptmax.X-cover_ft\r\n        ymin=ptmin.Y+cover_ft\r\n        ymax=ptmax.Y-cover_ft\r\n        zstart=ptmin.Z+cover_ft\r\n        zend=ptmax.Z-cover_ft\r\n        \r\n        corners=[(xmin, ymin), (xmax, ymin), (xmax, ymax), (xmin, ymax)]\r\n        \r\n        created_rebar=[]\r\n        \r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        norm=DB.XYZ(1,0,0)\r\n        \r\n        for cx, cy in corners:\r\n            p1=DB.XYZ(cx, cy, zstart)\r\n            p2=DB.XYZ(cx, cy, zend)\r\n            \r\n            barline=DB.Line.CreateBound(p1, p2)\r\n            curves=List[DB.Curve]()\r\n            curves.Add(barline)\r\n            \r\n            bar_termination=DBStruct.BarTerminationsData(doc)\r\n            new_rebar=DBStruct.Rebar.CreateFromCurves(\r\n            doc,\r\n            DBStruct.RebarStyle.Standard,\r\n            rebar_type,\r\n            host,\r\n            norm,\r\n            curves,\r\n            bar_termination,\r\n            True,\r\n            True\r\n            )\r\n            created_rebar.append(new_rebar.Id.ToString())\r\n            \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        OUT='Success: Created 4 longitudinal rebars'\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    ",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "c90eea17978b425d858fa15e5ce1e80d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e49a57bf3f0c46ccb321f4d0653dba3e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "acd2ea99c17c4ec59a084bb9032428fb",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
