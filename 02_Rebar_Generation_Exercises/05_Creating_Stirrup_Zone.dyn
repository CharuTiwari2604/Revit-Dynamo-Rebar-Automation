{
  "Uuid": "871ecc4c-4c92-4078-912b-f42de75d21ab",
  "IsCustomNode": false,
  "Description": "",
  "Name": "5rebarexercise",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk.Revit.DB as DB\r\nimport Autodesk.Revit.DB.Structure as DBStruct\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\nhost=UnwrapElement(IN[0])\r\n\r\nif not host:\r\n    OUT='Please Select rebar'\r\nelse:\r\n    rebar_type=DB.FilteredElementCollector(doc) \\\r\n    .OfClass(DBStruct.RebarBarType) \\\r\n    .WhereElementIsElementType() \\\r\n    .FirstElement()\r\n    \r\n    bbox=host.get_BoundingBox(None)\r\n    ptmin=bbox.Min\r\n    ptmax=bbox.Max\r\n    cover_ft=40.0/304.8\r\n    \r\n    xmin=ptmin.X+cover_ft\r\n    xmax=ptmax.X-cover_ft\r\n    ymin=ptmin.Y+cover_ft\r\n    ymax=ptmax.Y-cover_ft\r\n    \r\n    zstart=ptmin.Z+cover_ft\r\n    zend=ptmax.Z-cover_ft\r\n    totalht=zend-zstart\r\n    \r\n    densespace=100.0/304.8\r\n    sparsespace=200.0/304.8\r\n    \r\n    zonelength=totalht*0.20\r\n    \r\n    zelevations=[]\r\n    currentz=zstart\r\n    \r\n    while currentz <= zend:\r\n        zelevations.append(currentz)\r\n        inbottomzone=(currentz-zstart) <= zonelength\r\n        intopzone=(zend-currentz) <= zonelength\r\n        \r\n        if inbottomzone or intopzone:\r\n            currentz+=densespace\r\n        else:\r\n            currentz+=sparsespace\r\n    \r\n    \r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    \r\n    createdstup=[]\r\n    norm=DB.XYZ(0,0,1)\r\n    \r\n    for zpos in zelevations:\r\n        cp0=DB.XYZ(xmin, ymin, zpos)\r\n        cp1=DB.XYZ(xmax, ymin, zpos)\r\n        cp2=DB.XYZ(xmax, ymax, zpos)\r\n        cp3=DB.XYZ(xmin, ymax, zpos)\r\n        \r\n        l1=DB.Line.CreateBound(cp0, cp1)\r\n        l2=DB.Line.CreateBound(cp1, cp2)\r\n        l3=DB.Line.CreateBound(cp2, cp3)\r\n        l4=DB.Line.CreateBound(cp3, cp0)\r\n        \r\n        curves=List[DB.Curve]()\r\n        curves.Add(l1)\r\n        curves.Add(l2)\r\n        curves.Add(l3)\r\n        curves.Add(l4)\r\n        \r\n        bar_terminate=DBStruct.BarTerminationsData(doc)\r\n        stirrup_rebar=DBStruct.Rebar.CreateFromCurves(\r\n        doc,\r\n        DBStruct.RebarStyle.StirrupTie,\r\n        rebar_type,\r\n        host,\r\n        norm,\r\n        curves,\r\n        bar_terminate,\r\n        True,\r\n        True\r\n        )\r\n        \r\n        createdstup.append(stirrup_rebar.Id.ToString())\r\n        \r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT='Success: Created multiple stirrup'\r\n        \r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "144ead365b4a411bb4cee8a8712fad62",
      "NodeType": "PythonScriptNode",
      "Inputs": [
