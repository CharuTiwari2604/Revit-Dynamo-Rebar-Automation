  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Step 1 - Write boilerplate code\r\nimport clr\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Step 2 - Get all columns\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ncolumns = FilteredElementCollector(doc) \\\r\n            .OfCategory(BuiltInCategory.OST_StructuralColumns) \\\r\n            .WhereElementIsNotElementType() \\\r\n            .ToElements()\r\n\r\naudit_results = []\r\ntotal_concrete_volume_m3 = 0.0\r\nflagged_count = 0\r\n\r\n# Step 3 - Write QA/QC rules\r\nt = Transaction(doc, \"QAQC Column Audit\")\r\nt.Start()\r\n\r\nfor col in columns:\r\n    level_param = col.LookupParameter(\"Base Level\")\r\n    level_name = level_param.AsValueString() if level_param else \"Unknown level\"\r\n    \r\n    length_param = col.LookupParameter(\"System Length\")\r\n    length_ft = length_param.AsDouble() if length_param else 0.0\r\n    length_m = length_ft * 0.3048\r\n    \r\n    vol_param = col.LookupParameter(\"Volume\")\r\n    vol_ft = vol_param.AsDouble() if vol_param else 0.0\r\n    vol_m3 = vol_ft * 0.0283168\r\n    total_concrete_volume_m3 += vol_m3\r\n    \r\n    comments_param = col.LookupParameter(\"Comments\")\r\n    \r\n    if length_m > 6.0:\r\n        status = f\"Warning: Exceed 6m transport limit ({length_m:.2f} m)\"\r\n        flagged_count += 1\r\n    else:\r\n        status = \"Pass: Approved Length\"\r\n        \r\n    if comments_param and not comments_param.IsReadOnly:\r\n        comments_param.Set(status)\r\n        \r\n    audit_results.append([col.Id.ToString(), level_name, round(length_m, 2), status])\r\n\r\nt.Commit()\r\n\r\n# Step 4 - Output generation\r\nsummary_text = (\r\n    f\"Total Columns = {len(columns)}\\n\"\r\n    f\"Flagged Columns (>6m) = {flagged_count}\\n\"\r\n    f\"Total Concrete Volume = {total_concrete_volume_m3:.2f} m3\"\r\n)\r\n\r\nOUT = summary_text",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "35a70c9512cf462aaf616e9458d88eb3",
      "NodeType": "PythonScriptNode",
