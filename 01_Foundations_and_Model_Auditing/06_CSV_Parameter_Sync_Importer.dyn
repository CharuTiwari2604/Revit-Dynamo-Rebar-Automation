    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport csv\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nupdated_count = 0\r\nfailed_count = 0\r\nsync_log = []\r\n\r\npath = r'C:\\Users\\yogen\\Desktop\\Dynamo  Exercise\\exercise5.csv'\r\n\r\nt = Transaction(doc, 'Import Changes from csv file')\r\nt.Start()\r\n\r\ntry:\r\n    with open(path, mode='r') as f:\r\n        reader = csv.reader(f)\r\n        header = next(reader, None) \r\n        \r\n        for row in reader:\r\n            if not row or len(row) < 5:\r\n                continue\r\n                \r\n            rowId = row[0].strip()\r\n            status = row[4].strip() \r\n            \r\n            try:\r\n                elemId = ElementId(int(rowId))\r\n                elem = doc.GetElement(elemId)\r\n                \r\n                if elem:\r\n                    comments_param = elem.LookupParameter(\"Comments\")\r\n                    \r\n                    if comments_param and not comments_param.IsReadOnly:\r\n                        comments_param.Set(status)\r\n                        updated_count += 1\r\n                        sync_log.append(f\"Synced ID {rowId} -> '{status}'\") \r\n                    else:\r\n                        failed_count += 1\r\n                else:\r\n                    failed_count += 1\r\n                    \r\n            except Exception:\r\n                failed_count += 1\r\n\r\n    t.Commit()\r\n    status_msg = f\"SUCCESS: Synced {updated_count} elements from CSV to Revit.\"\r\n\r\nexcept Exception as file_err:\r\n    t.RollBack()  \r\n    status_msg = f\"ERROR reading file: {str(file_err)}\"\r\n\r\nsummary_output = (\r\n    f\"=== CSV to Revit Sync Summary ===\\n\"\r\n    f\"• Status: {status_msg}\\n\"\r\n    f\"• Successfully Updated: {updated_count} elements\\n\"\r\n    f\"• Failed/Skipped: {failed_count} elements\\n\\n\"\r\n    f\"Sample Updates:\\n\" + \"\\n\".join(sync_log[:5])\r\n)\r\n\r\nOUT = summary_output",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "f4545147cb10452bbcbe40e634444575",
