  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\nbeam=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralFraming) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\nunmarked_count=0\r\naudit=[]\r\n\r\nt=Transaction(doc, 'Beam QA/QC Audit')\r\nt.Start()\r\n\r\nfor b in beam:\r\n    mark_param=b.LookupParameter('Mark')\r\n    mark_val=mark_param.AsString() if mark_param else None\r\n    comment_param=b.LookupParameter('Comments')\r\n    \r\n    if not mark_val or mark_val.strip()==\"\":\r\n        unmarked_count+=1\r\n        status='QA/QC Warning: Missing Mark ID'\r\n        \r\n        if comment_param and not comment_param.IsReadOnly:\r\n            comment_param.Set(status)\r\n            \r\n        audit.append(f'BeamId: {b.Id.ToString()} -> Flagged(No mark)')\r\n       \r\nt.Commit\r\n\r\nsummary= (\r\n    f\"=== Beam QA/QC Identification Audit ===\\n\"\r\n    f\"• Total Beams Inspected: {len(beam)}\\n\"\r\n    f\"• Beams Missing Mark IDs: {unmarked_count}\\n\\n\"\r\n    f\"First 5 Flagged Items:\\n\" + \"\\n\".join(audit[:5])\r\n)\r\n\r\nOUT =summary\r\n\r\n\r\n\r\n\r\n\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "ec24ef99c84247039850a50e6fd59006",
      "NodeType": "PythonScriptNode",
