  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\ncols=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralColumns) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\ntotal_vol_cols=0.0\r\n\r\nfor c in cols:\r\n    vol_param = c.LookupParameter('Volume')\r\n    vol_ft3 = vol_param.AsDouble() if vol_param else 0.0\r\n    vol_m3 = vol_ft3 * 0.0283168\r\n    total_vol_cols += vol_m3\r\n\r\nbeams=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralFraming) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\ntotal_vol_beams = 0.0\r\n\r\nfor b in beams:\r\n    bvol_param = b.LookupParameter('Volume')\r\n    bvol_ft3 = bvol_param.AsDouble() if bvol_param else 0.0\r\n    bvol_m3 = bvol_ft3 * 0.0283168\r\n    total_vol_beams += bvol_m3\r\n\r\n\r\nfootings=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralFoundation) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\ntotal_vol_foot = 0.0\r\n\r\nfor f in footings:\r\n    fvol_param = f.LookupParameter('Volume')\r\n    fvol_ft3 = fvol_param.AsDouble() if fvol_param else 0.0\r\n    fvol_m3 = fvol_ft3 * 0.0283168\r\n    total_vol_foot += fvol_m3\r\n\r\n\r\ntotal_vol = total_vol_cols + total_vol_beams + total_vol_foot\r\n\r\nOUT= f\"Total Volume: {total_vol:.2f} m3\"\r\n\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "5b09e0f06576430788d0dd979289caf5",
      "NodeType": "PythonScriptNode",
