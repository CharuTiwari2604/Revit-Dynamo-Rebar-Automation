  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\ncols=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralColumns) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\ntallcolcount=0\r\naudit=[]\r\nmaxht=4.5\r\n\r\nfor c in cols:\r\n    bbox=c.get_BoundingBox(None)\r\n    if bbox:\r\n        htinft=bbox.Max.Z-bbox.Min.Z\r\n        htinm=htinft*0.3048\r\n        \r\n        colId=c.Id.ToString()\r\n        \r\n        if htinm>maxht:\r\n            tallcolcount+=1\r\n            status='Flagged: Height {htinm:.2f} m'\r\n        else:\r\n            status='Pass: Height {htinm:.2f} m ie. under 4.5m'\r\n            \r\n        audit.append(f'Id: {colId} | Height: {htinm:.2f} m | Status: {status}')\r\n        \r\nsummary=(f'Height Audit\\n'\r\nf'Total Columns Evaluated: {len(cols)} \\n'\r\nf'Columns Exceeding Max Height : {tallcolcount} \\n'\r\nf'Sample Column Dimension: \\n' +'\\n'.join(audit[:5])\r\n)\r\n\r\nOUT=summary\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "f4cc635c929444019078ce3bec957f6e",
      "NodeType": "PythonScriptNode",
