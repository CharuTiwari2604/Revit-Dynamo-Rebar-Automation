  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport csv\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\ncol=FilteredElementCollector(doc) \\\r\n.OfCategory(BuiltInCategory.OST_StructuralColumns) \\\r\n.WhereElementIsNotElementType() \\\r\n.ToElements()\r\n\r\nflagged_count=0\r\n\r\npath=r'C:\\Users\\yogen\\Desktop\\Dynamo  Exercise\\exercise5.csv'\r\n\r\nwith open(path, mode='w', newline='') as f:\r\n    writer=csv.writer(f)\r\n    writer.writerow(['Element ID',  'Level', 'Length', 'Volume', 'QA/QC Status'])\r\n    \r\n    for c in col:\r\n        colId=c.Id.ToString()\r\n        level=c.LookupParameter('Base Level')\r\n        level_name=level.AsValueString() if level else 'Unknown Level'\r\n        \r\n        length_param=c.LookupParameter('System Length')\r\n        length_ft=length_param.AsDouble() if length_param else 0.0\r\n        length_m=length_ft * 0.3048\r\n        \r\n        vol_param=c.LookupParameter('Volume')\r\n        vol_ft=vol_param.AsDouble() if vol_param else 0.0\r\n        vol_m3=vol_ft * 0.0283168\r\n        \r\n        if length_m > 4:\r\n            status='Warning: Exceed 4m Transport Limit'\r\n            flagged_count+=1\r\n        else:\r\n            status='Pass: Approved Length'\r\n            \r\n        writer.writerow([colId, level_name, length_m, vol_m3, status])\r\n    \r\nOUT= f'Successfully saved on folder'\r\n  \r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "9f09d37ea7394307a22caa99215214cb",
      "NodeType": "PythonScriptNode",
