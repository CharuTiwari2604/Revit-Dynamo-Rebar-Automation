    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import  *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc=DocumentManager.Instance.CurrentDBDocument\r\n\r\nlevel='01 - Entry Level'\r\n\r\nall_levels = FilteredElementCollector(doc) \\\r\n    .OfClass(Level) \\\r\n    .WhereElementIsNotElementType() \\\r\n    .ToElements()\r\n\r\nlevel_1=None\r\n\r\nfor lvl in all_levels:\r\n    if lvl.Name==level:\r\n        level_1=lvl.Id\r\n        break\r\n        \r\nif level_1:\r\n    level_filter=ElementLevelFilter(level_1)\r\n    level_cols=FilteredElementCollector(doc) \\\r\n    .OfCategory(BuiltInCategory.OST_StructuralColumns) \\\r\n    .WherePasses(level_filter) \\\r\n    .WhereElementIsNotElementType() \\\r\n    .ToElements()\r\n    \r\n    col_details=[]\r\n    total_vol=0.0\r\n    \r\n    for col in level_cols:\r\n        colId=col.Id.ToString()\r\n        vol_param=col.LookupParameter('Volume')\r\n        vol_ft3=vol_param.AsDouble() if vol_param else 0.0\r\n        vol_m3=vol_ft3 * 0.0283168\r\n        total_vol+=vol_m3\r\n        \r\n        col_details.append(f\"ID: {colId} | Vol: {vol_m3:.2f} m3\")\r\n    \r\n    summary_output = (\r\n        f\" Level Filter Audit: '{level}' \\n\"\r\n        f\"• Columns Found on {level}: {len(level_cols)}\\n\"\r\n        f\"• Total Concrete Volume on Floor: {total_vol:.2f} m3\\n\\n\"\r\n        f\"Sample Elements:\\n\" + \"\\n\".join(col_details[:5])  # Show first 5\r\n    )\r\n        \r\nelse:\r\n     summary_output = f\"ERROR: Level '{level}' was not found in the model.\"\r\n     \r\nOUT=summary_output \r\n   ",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "09b99c45ec1e48ffa38c357edf1ea61a",
      "NodeType": "PythonScriptNode",
